---
// Business partner (B2B) enquiry form. Posts to POST /api/enquire (form_type "partner"): Turnstile check, server-side
// validation, saved to the enquiries inbox and emailed to the owner. See EnquiryForm.astro.
import TurnstileWidget from './TurnstileWidget.astro';
import { PARTNER_TYPES } from '../lib/enquiry-schemas';
---

<form class="enquire-form enquire-form--box" method="post" action="/api/enquire" id="partner-form" data-enquiry-form data-endpoint="/api/enquire" data-success-title="Thank you — we have received your proposal." data-success-text="Our partnerships team will reply within three business days.">
      <input type="hidden" name="form_type" value="partner" />

      <div class="hp-field" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="hp" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="form-field">
        <label for="pf-type">How Would You Like To Work With Us?</label>
        <select id="pf-type" name="partner_type">
          {PARTNER_TYPES.map((p) => <option value={p}>{p}</option>)}
        </select>
        <span class="field-underline" />
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="pf-company">Company <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="pf-company" name="company" required minlength="2" maxlength="120" placeholder="e.g. Horizon Journeys Ltd" autocomplete="organization" />
          <span class="field-underline" />
        </div>
        <div class="form-field">
          <label for="pf-website">Website</label>
          <input type="text" id="pf-website" name="website" maxlength="200" placeholder="e.g. www.horizonjourneys.com" autocomplete="url" />
          <span class="field-underline" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="pf-name">Your Name <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="pf-name" name="name" required minlength="2" maxlength="100" placeholder="e.g. Sarah Johnson" autocomplete="name" />
          <span class="field-underline" />
        </div>
        <div class="form-field">
          <label for="pf-role">Your Role</label>
          <input type="text" id="pf-role" name="role" maxlength="80" placeholder="e.g. Head of Product" autocomplete="organization-title" />
          <span class="field-underline" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="pf-email">Work Email <span class="req" aria-hidden="true">*</span></label>
          <input type="email" id="pf-email" name="email" required maxlength="200" placeholder="e.g. sarah@horizonjourneys.com" autocomplete="email" />
          <span class="field-underline" />
        </div>
        <div class="form-field">
          <label for="pf-phone">Phone / WhatsApp</label>
          <input type="tel" id="pf-phone" name="phone" maxlength="30" placeholder="e.g. +44 20 7946 0000" autocomplete="tel" />
          <span class="field-underline" />
        </div>
      </div>

      <div class="form-field">
        <label for="pf-country">Country <span class="req" aria-hidden="true">*</span></label>
        <input type="text" id="pf-country" name="country" required maxlength="80" placeholder="e.g. United Kingdom" autocomplete="country-name" />
        <span class="field-underline" />
      </div>

      <div class="form-field">
        <label for="pf-message">How Could We Work Together? <span class="req" aria-hidden="true">*</span></label>
        <textarea id="pf-message" name="message" required maxlength="2000" placeholder="e.g. We sell small-group Himalayan tours to UK travelers and are looking for a trusted Bhutan partner for 2027."></textarea>
        <span class="field-underline" />
      </div>

      <TurnstileWidget />
      <button type="submit" class="btn btn-solid-gold">Send Proposal</button>
</form>

<script>
  import '../scripts/enquiry-forms';
</script>
