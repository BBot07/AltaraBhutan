---
import AdminBase from '../../layouts/AdminBase.astro';
import { checkCredentials, clearFailures, createSession, hashIp, isLockedOut, recordFailure, setSessionCookie } from '../../lib/auth';

export const prerender = false;

// Loose on purpose: local admin accounts may use a bare domain such as admin@altara.
const EMAIL = /^[^\s@]+@[^\s@]+$/;
let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');

  try {
    const ipHash = await hashIp(Astro.clientAddress || 'unknown');
    if (!EMAIL.test(email) || email.length > 200 || password.length < 1 || password.length > 200) {
      error = 'Enter your email and password.';
    } else if (await isLockedOut(email, ipHash)) {
      error = 'Too many failed attempts. Please wait 15 minutes and try again.';
    } else {
      const user = await checkCredentials(email, password);
      if (user) {
        await clearFailures(email);
        const { token, expires } = await createSession(user.id);
        setSessionCookie(Astro.cookies, token, expires);
        return Astro.redirect('/admin');
      }
      await recordFailure(email, ipHash);
      error = 'Invalid email or password.';
    }
  } catch (e) {
    console.error('[login] failed:', e);
    error = 'Something went wrong. Please try again.';
  }
}

const field =
  'mt-2 block w-full border border-line bg-white px-4 py-3 text-base text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40';
---

<AdminBase title="Sign in">
  <main class="grid min-h-screen lg:grid-cols-2">
    <!-- Photo panel (left on desktop, a short banner on phones) -->
    <aside class="relative flex min-h-[320px] items-end overflow-hidden bg-ink lg:min-h-screen">
      <img
        src="/assets/images/image/punakha dzong1.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/30"></div>
      <a
        href="/"
        class="absolute left-6 top-6 z-20 inline-flex items-center gap-2 border border-white/60 bg-black/20 px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.16em] text-white transition-colors hover:bg-white hover:text-ink lg:left-14 lg:top-10"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M20 12H4M10 6l-6 6 6 6" /></svg>
        Back to website
      </a>
      <div class="relative z-10 px-6 pb-8 pt-24 lg:p-14">
        <img src="/assets/images/logo/logo-white.svg" alt="Altara Bhutan" class="mb-6 h-14 w-auto lg:h-20" />
        <p class="font-display text-3xl uppercase leading-tight tracking-wide text-white lg:text-5xl">
          Private journeys,<br /><span class="text-accent">made by hand</span>
        </p>
        <p class="mt-3 hidden max-w-sm text-sm leading-relaxed text-white/80 lg:block">
          Manage tours, journal posts, the gallery and enquiries for Altara Bhutan.
        </p>
      </div>
    </aside>

    <!-- Sign-in form (right) -->
    <section class="relative flex items-center justify-center overflow-hidden px-5 py-12 lg:px-16">
      <div class="relative w-full max-w-sm border border-line bg-white/90 p-8 shadow-sm backdrop-blur-[2px] sm:p-10">
        <p class="eyebrow mb-2">Altara Bhutan</p>
        <h1 class="font-display text-3xl font-medium tracking-wide text-ink">Admin sign in</h1>
        <p class="mt-2 text-sm text-body">Welcome back. Sign in to manage the site.</p>

        {error && <p role="alert" class="mt-5 border border-red-700 bg-red-50 p-3 text-sm text-red-800">{error}</p>}

        <form method="post" class="mt-8 space-y-5">
          <div>
            <label for="email" class="block text-[12px] font-bold uppercase tracking-[0.16em] text-ink">Email</label>
            <input id="email" name="email" type="email" required maxlength="200" autocomplete="username" value={email} class={field} />
          </div>
          <div>
            <label for="password" class="block text-[12px] font-bold uppercase tracking-[0.16em] text-ink">Password</label>
            <input id="password" name="password" type="password" required maxlength="200" autocomplete="current-password" class={field} />
          </div>
          <button type="submit" class="btn btn-solid w-full">Sign in</button>
        </form>
      </div>
    </section>
  </main>
</AdminBase>
