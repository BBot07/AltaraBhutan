{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (SSR) deployment: `npm run deploy` = `astro build && wrangler deploy`.
  "name": "altarabhutan",
  // Entry point supplied by @astrojs/cloudflare 14.x (the build rewrites it to dist/server/entry.mjs).
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Newest date the installed Cloudflare runtime (workerd 1.20261101, bundled with @astrojs/cloudflare 14.4.4) accepts.
  // 2026-11-23 fails the build and `astro dev`; raise it once the adapter ships a newer runtime.
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static files (photos, CSS, JS, prerendered pages). The adapter points the real directory at dist/client when it
  // builds; unmatched URLs fall through to the 404 page instead of the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "altara-db",
      "database_id": "b6bd4449-bc8d-4110-b674-37447fe31e3f",
      // Migration files live here (created with `npx wrangler d1 migrations create altara-db <name>`).
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded tour photos (served from /media/uploads/...). Locally this is simulated on disk.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "altara-media" }]
  // The admin login secret is not stored here: run `npx wrangler secret put AUTH_SECRET` once the Worker exists.
}
