{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (SSR) deployment: `npm run deploy` = `astro build && wrangler deploy`.
  "name": "altarabhutan",
  // Entry point supplied by @astrojs/cloudflare 14.x (the build rewrites it to dist/server/entry.mjs).
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Newest date the installed Cloudflare runtime (workerd 1.20261101, bundled with @astrojs/cloudflare 14.4.4) accepts.
  // 2026-11-23 fails the build and `astro dev`; raise it once the adapter ships a newer runtime.
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static files (photos, CSS, JS, prerendered pages). The adapter points the real directory at dist/client when it
  // builds; unmatched URLs fall through to the 404 page instead of the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "altara-db",
      "database_id": "b6bd4449-bc8d-4110-b674-37447fe31e3f",
      // Migration files live here (created with `npx wrangler d1 migrations create altara-db <name>`).
      "migrations_dir": "migrations"
    }
  ],
  // Key-value store the Astro Cloudflare adapter uses for sessions. Created with `npx wrangler kv namespace create SESSION`,
  // so a deploy never depends on it being auto-created.
  "kv_namespaces": [{ "binding": "SESSION", "id": "15de86bdcdd74fa681ffb13032cc0b00" }],
  // Uploaded tour photos (served from /media/uploads/...). Locally this is simulated on disk.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "altara-media" }]
  // Secrets are never stored here. Set them once the Worker exists (or in Workers & Pages > altarabhutan > Settings > Variables and Secrets):
  //   npx wrangler secret put AUTH_SECRET            admin login
  //   npx wrangler secret put TURNSTILE_SECRET_KEY   Cloudflare Turnstile secret key for the contact forms (required: forms are refused without it)
  //   npx wrangler secret put RESEND_API_KEY         optional: emails each enquiry to the owner (without it enquiries are only saved in D1)
  // Optional plain variables: ENQUIRY_TO_EMAIL, ENQUIRY_FROM_EMAIL (see src/lib/notify.ts).
}
